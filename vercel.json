{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/gev?gevPath=$1" }
  ],
  "functions": {
    "api/gev.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  }
}
